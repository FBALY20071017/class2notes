# 本地 Ollama（默认，无需 API key）
OLLAMA_BASE_URL=http://localhost:11434/v1
# 侧边栏默认选中的模型，改成 ollama list 里你实际装的名字
OLLAMA_MODEL=gpt-oss:20b

# 云端转写（可选）：必须支持 OpenAI 格式 /audio/transcriptions
CLOUD_ASR_BASE_URL=https://api.siliconflow.cn/v1
CLOUD_ASR_API_KEY=
CLOUD_ASR_MODEL=XingChenAGI/XingChenASR-V3.2-Ultra

# 云端笔记（可选）：任何 OpenAI 兼容对话接口
# DeepSeek 只提供文本模型，不能做语音转写；转写仍需本地或其他厂商
CLOUD_LLM_BASE_URL=https://api.deepseek.com
CLOUD_LLM_API_KEY=
CLOUD_LLM_MODEL=deepseek-chat

# 本地转写模型
LOCAL_ASR_MODEL=mlx-community/whisper-large-v3-turbo

# 兼容旧变量名（可选）：OPENAI_BASE_URL / OPENAI_API_KEY / ASR_MODEL / LLM_MODEL
